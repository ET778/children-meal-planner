.add-box { margin-bottom: 20rpx; } .add-btn { height: 64rpx; border-radius: 16rpx; background: #fdf0eb; color: #d4946b; font-size: 25rpx; font-weight: 900; } .add-form { padding: 18rpx; border-radius: 18rpx; background: #fff9f2; border: 1rpx solid #f0e8dd; } .add-input { height: 64rpx; padding: 0 18rpx; border-radius: 14rpx; background: #fff; border: 1rpx solid #f0e8dd; font-size: 25rpx; } .emoji-row { display: grid; grid-template-columns: repeat(8, 1fr); gap: 10rpx; margin: 16rpx 0; } .emoji-choice { display: flex; align-items: center; justify-content: center; width: 100%; aspect-ratio: 1; min-height: 54rpx; border-radius: 50%; background: #fff; border: 1rpx solid #f0e8dd; font-size: 31rpx; box-sizing: border-box; } .emoji-choice.active { border-color: #e8a87c; background: #fdf0eb; } .form-actions { display: flex; gap: 12rpx; } .confirm-btn, .cancel-btn { flex: 1; height: 58rpx; border-radius: 14rpx; font-size: 24rpx; font-weight: 900; } .confirm-btn { background: #8fbc8f; color: #fff; } .cancel-btn { background: #fff; color: #7d7067; border: 1rpx solid #f0e8dd; }
.candidates-label { margin: 20rpx 0 14rpx; color: #7d7067; font-size: 24rpx; font-weight: 900; } .dish-grid { display: grid; gap: 16rpx; } .dish-card { position: relative; padding: 20rpx; border-radius: 22rpx; background: #fff; border: 2rpx solid #f0e8dd; overflow: hidden; } .dish-card.selected { border-color: #e8a87c; background: #fff7ef; } .dc-del { position: absolute; right: 14rpx; top: 12rpx; z-index: 2; width: 38rpx; height: 38rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #ef6f61; color: #fff; font-size: 30rpx; line-height: 1; font-weight: 900; } .dc-check { position: absolute; right: 16rpx; bottom: 16rpx; width: 38rpx; height: 38rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #e8a87c; color: #fff; opacity: 0; font-size: 24rpx; } .dish-card.selected .dc-check { opacity: 1; } .dish-main { padding-right: 50rpx; } .dish-emoji { width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; background: #fff9f2; font-size: 42rpx; } .dish-name { margin-top: 12rpx; font-size: 28rpx; font-weight: 900; line-height: 1.35; } .dish-category { display: inline-flex; margin-top: 10rpx; padding: 4rpx 14rpx; border-radius: 999rpx; background: #fdf0eb; color: #c98b6a; font-size: 21rpx; font-weight: 800; } .dish-desc { margin-top: 8rpx; color: #a39585; font-size: 23rpx; line-height: 1.45; }
