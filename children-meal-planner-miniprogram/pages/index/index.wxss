.section-title { text-align: center; margin: 44rpx 0 26rpx; } .section-heading { font-size: 38rpx; font-weight: 900; } .section-desc { margin-top: 8rpx; color: #a39585; font-size: 24rpx; } .mode-tabs { display: flex; width: 360rpx; margin: 0 auto 28rpx; padding: 8rpx; border-radius: 999rpx; background: #fffaf5; border: 1rpx solid #f0e8dd; } .mode-tab { flex: 1; height: 62rpx; border-radius: 999rpx; font-size: 26rpx; font-weight: 800; color: #7d7067; background: transparent; } .mode-tab.active { background: linear-gradient(135deg,#e8a87c,#f0b890); color: #fff; } .daybar { white-space: nowrap; margin-bottom: 26rpx; padding: 8rpx; border-radius: 20rpx; background: #fff; border: 1rpx solid #f0e8dd; } .daytab { display: inline-flex; align-items: center; justify-content: center; width: 96rpx; height: 58rpx; border-radius: 16rpx; margin-right: 6rpx; font-size: 24rpx; font-weight: 800; color: #7d7067; background: transparent; vertical-align: top; } .daytab.active { background: linear-gradient(135deg,#e8a87c,#f0b890); color: #fff; }
