.summary-bar { display: flex; flex-wrap: wrap; gap: 12rpx; padding: 20rpx; border-radius: 24rpx; background: linear-gradient(180deg,#fff,#fffaf5); border: 1rpx solid #f0e8dd; } .summary-chip { display: inline-flex; align-items: center; justify-content: center; min-height: 54rpx; padding: 0 22rpx; border-radius: 999rpx; font-size: 24rpx; font-weight: 800; } .summary-chip text { margin-left: 8rpx; font-size: 30rpx; } .early { background: linear-gradient(135deg,#fff3cd,#ffe8b8); color: #9b7d00; } .noon { background: linear-gradient(135deg,#ffe4d4,#ffd4a8); color: #c47844; } .night { background: linear-gradient(135deg,#e0f0e0,#d0e8cc); color: #4a7c3a; } .soup { background: linear-gradient(135deg,#eee6fa,#e0d4f4); color: #7b5e9e; } .action-row { display: flex; gap: 14rpx; margin: 18rpx 0 28rpx; } .secondary-btn { flex: 1; height: 60rpx; border-radius: 16rpx; background: #fff; border: 2rpx solid #e8a87c; color: #d4946b; font-size: 24rpx; font-weight: 800; }
