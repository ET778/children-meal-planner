.global-warning { margin-top: 28rpx; padding: 26rpx; border-radius: 24rpx; background: linear-gradient(180deg,#f9e0d8,#fdf6f4); border: 1rpx solid #f9e0d8; } .global-title { color: #e07a5f; font-size: 28rpx; font-weight: 900; margin-bottom: 12rpx; } .warning-item { color: #7d7067; font-size: 24rpx; line-height: 1.6; margin-top: 8rpx; }
